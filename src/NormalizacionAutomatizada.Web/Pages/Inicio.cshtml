@page "/"
@model PaginaInicioModel
@{
    ViewData["Title"] = "Normalizacion automatizada";
}

<section class="workspace" aria-labelledby="page-title">
    <header class="page-heading">
        <p class="section-label">Proyecto I / Administraci&oacute;n de Base de Datos II</p>
        <h1 id="page-title">Carga de plantilla</h1>
        <p>Importa un libro Excel con pares <code>Tabla_XX</code> y <code>Datos_XX</code>. Al validarlo, la aplicaci&oacute;n muestra los datos que quedan disponibles para el an&aacute;lisis de normalizaci&oacute;n.</p>
    </header>

    <section class="upload-card" aria-labelledby="upload-title">
        <div class="card-heading">
            <div>
                <p class="section-label">1. Importar libro</p>
                <h2 id="upload-title">Archivo Excel</h2>
            </div>
            <p>Descarga una plantilla, compl&eacute;tala y c&aacute;rgala para comprobar su estructura.</p>
        </div>

        <div class="template-links" aria-label="Plantillas disponibles">
            <a class="template-link" href="/plantillas/Plantilla_Maestra_Normalizacion_Simplificada_v2.xlsx" download>
                <strong>Plantilla maestra</strong>
                <span>Base vac&iacute;a para iniciar su propio caso.</span>
            </a>
            <a class="template-link" href="/plantillas/Plantilla_Prueba_Depuracion_3_Tablas.xlsx" download>
                <strong>Ejemplo para depuraci&oacute;n</strong>
                <span>Tres tablas completas con registros de prueba.</span>
            </a>
        </div>

        <form class="upload-form" method="post" enctype="multipart/form-data">
            <label asp-for="ArchivoPlantilla">Seleccione el archivo de normalizaci&oacute;n</label>
            <input asp-for="ArchivoPlantilla" accept=".xlsx" />
            <p class="field-hint">Solo se aceptan archivos <code>.xlsx</code> que contengan pares <code>Tabla_XX</code> y <code>Datos_XX</code>.</p>
            <button class="analysis-button" type="submit">Validar y mostrar datos</button>
        </form>

        @if (Model.ResultadoValidacion is { EsValido: false } error)
        {
            <div class="upload-alert upload-alert--error" role="alert">@error.MensajeError</div>
        }
        else if (Model.ResultadoAnalisis is { EsValido: false } analisisConErrores)
        {
            <div class="upload-alert upload-alert--error" role="alert">
                <strong>Corrige la plantilla antes de analizarla.</strong>
                <ul class="analysis-list">
                    @foreach (var mensajeError in analisisConErrores.Errores)
                    {
                        <li>@mensajeError</li>
                    }
                </ul>
            </div>
        }
        else if (Model.ResultadoAnalisis is { EsValido: true } analisis)
        {
            var totalRegistros = analisis.Tablas.Sum(tabla => tabla.CantidadRegistros);

            <div class="upload-alert upload-alert--success" role="status">
                <strong>Plantilla v&aacute;lida.</strong> Se importaron @analisis.Tablas.Count tabla@(analisis.Tablas.Count == 1 ? string.Empty : "s") y @totalRegistros registro@(totalRegistros == 1 ? string.Empty : "s").
                <p>Los datos originales se guardaron temporalmente para el siguiente paso.</p>
            </div>
        }
    </section>

    @if (Model.EntradaCargada is { } entrada)
    {
        var totalRegistros = entrada.Tablas.Sum(tabla => tabla.Registros.Count);

        <section class="preview-panel" aria-labelledby="preview-title">
            <header class="preview-heading">
                <div>
                    <p class="section-label">2. Resultado de la carga</p>
                    <h2 id="preview-title">Vista previa de datos importados</h2>
                    <p>Esta vista corresponde a la entrada guardada en sesi&oacute;n y disponible mediante <code>IAlmacenEntradaNormalizacion.Obtener()</code>.</p>
                </div>
                <p class="preview-count">@entrada.Tablas.Count tabla@(entrada.Tablas.Count == 1 ? string.Empty : "s")<br />@totalRegistros registro@(totalRegistros == 1 ? string.Empty : "s")</p>
            </header>

            @foreach (var tabla in entrada.Tablas)
            {
                <article class="table-preview">
                    <header class="table-preview-heading">
                        <div>
                            <h3>Tabla_@tabla.Numero</h3>
                            <p>@tabla.Columnas.Count columnas y @tabla.Registros.Count registro@(tabla.Registros.Count == 1 ? string.Empty : "s") importado@(tabla.Registros.Count == 1 ? string.Empty : "s").</p>
                        </div>
                    </header>

                    <ul class="column-list" aria-label="Estructura de Tabla_@tabla.Numero">
                        @foreach (var columna in tabla.Columnas)
                        {
                            <li>
                                <strong>@columna.Nombre</strong>
                                <span>@columna.TipoDato</span>
                                @if (columna.EsClavePrimaria)
                                {
                                    <small>PK</small>
                                }
                                @if (columna.EsClaveForanea)
                                {
                                    <small>FK</small>
                                }
                            </li>
                        }
                    </ul>

                    <div class="table-scroll">
                        <table>
                            <thead>
                                <tr>
                                    @foreach (var columna in tabla.Columnas)
                                    {
                                        <th scope="col">@columna.Nombre</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var registro in tabla.Registros.Take(5))
                                {
                                    <tr>
                                        @foreach (var columna in tabla.Columnas)
                                        {
                                            <td>@(registro.Valores.TryGetValue(columna.Nombre, out var valor) ? valor ?? "Sin dato" : "Sin dato")</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (tabla.Registros.Count > 5)
                    {
                        <p class="preview-note">La vista previa muestra los primeros 5 registros de los @tabla.Registros.Count importados.</p>
                    }
                </article>
            }
        </section>
    }

    @if (Model.ResultadosNormalizacion.Count > 0)
    {
        <section class="preview-panel" aria-labelledby="normalization-title">
            <header class="preview-heading">
                <div>
                    <p class="section-label">3. Propuesta automatica</p>
                    <h2 id="normalization-title">Tablas en tercera forma normal</h2>
                    <p>Las claves y dependencias se infieren de los registros cargados. Revise las advertencias antes de ejecutar el SQL.</p>
                </div>
                <a class="analysis-button" asp-page-handler="Sql">Descargar SQL</a>
            </header>

            @foreach (var resultado in Model.ResultadosNormalizacion)
            {
                <article class="table-preview">
                    <header class="table-preview-heading">
                        <h3>Origen: Tabla_@resultado.Numero</h3>
                        <p>Claves candidatas: @(resultado.ClavesCandidatas.Count == 0 ? "sin evidencia suficiente" : string.Join(" | ", resultado.ClavesCandidatas.Select(clave => string.Join(" + ", clave.Columnas)))).</p>
                        <p>Dependencias observadas: @resultado.DependenciasObservadas.Count.</p>
                    </header>

                    @foreach (var tabla in resultado.TablasTerceraFormaNormal)
                    {
                        <div class="table-preview-heading">
                            <h3>@tabla.Nombre</h3>
                            <p>PK: @(tabla.ClavePrimaria.Count == 0 ? "sin definir" : string.Join(" + ", tabla.ClavePrimaria)).</p>
                        </div>
                        <ul class="column-list">
                            @foreach (var columna in tabla.Columnas)
                            {
                                <li><strong>@columna.Nombre</strong><span>@columna.TipoDato</span></li>
                            }
                        </ul>
                        @if (tabla.ClavesForaneas.Count > 0)
                        {
                            <p class="preview-note">FK: @string.Join("; ", tabla.ClavesForaneas.Select(referencia => $"{string.Join(" + ", referencia.Columnas)} -> {referencia.TablaDestino}"))</p>
                        }
                    }

                    @if (resultado.Advertencias.Count > 0)
                    {
                        <div class="upload-alert upload-alert--error">
                            @foreach (var advertencia in resultado.Advertencias)
                            {
                                <p>@advertencia</p>
                            }
                        </div>
                    }
                </article>
            }
        </section>
    }
</section>
